              "computed_optional_required": "required",
              "description": "The pod ID to act on"
            }
          },
          {
            "name": "action",
            "string": {
              "computed_optional_required": "required",
              "description": "Action to perform: start, stop, restart, terminate"
            }
          },
          {
            "name": "status",
