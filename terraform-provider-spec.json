            "string": {
              "computed_optional_required": "computed",
              "description": "GPU type ID"
            }
          },
          {
            "name": "gpu_total",
            "int64": {
              "computed_optional_required": "computed",
              "description": "Total GPU count"
            }
          },
          {
            "name": "listed",
            "bool": {
              "computed_optional_required": "computed",
              "description": "Whether machine is listed"
            }
          },
          {
            "name": "secure_cloud",
            "bool": {
              "computed_optional_required": "computed",
