{
  "version": "0.1",
  "provider": {
    "name": "runpod",
    "description": "Terraform provider for RunPod infrastructure management",
    "website": "https://www.runpod.io",
    "documentation": "https://docs.runpod.io",
    "github": "https://github.com/runpod",
    "attributes": [
      {
        "name": "api_key",
        "string": {
          "computed_optional_required": "optional",
          "description": "RunPod API key",
          "sensitive": true
        }
      }
    ]
  },
  "dataSources": [
    {
      "name": "pod",
      "description": "Retrieve information about a specific RunPod pod",
      "schema": {
        "attributes": [
          {
            "name": "id",
            "string": {
              "computed_optional_required": "required",
              "description": "The pod ID"
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "computed",
              "description": "Pod name"
            }
          },
          {
            "name": "status",
            "string": {
              "computed_optional_required": "computed",
              "description": "Current pod status (RUNNING, STOPPED, etc.)"
            }
          },
          {
            "name": "gpu_count",
            "int64": {
              "computed_optional_required": "computed",
              "description": "Number of GPUs allocated"
            }
          },
          {
            "name": "gpu_type_id",
            "string": {
              "computed_optional_required": "computed",
              "description": "GPU type ID"
            }
          },
          {
            "name": "machine_id",
            "string": {
              "computed_optional_required": "computed",
              "description": "Machine ID where pod is running"
            }
          },
          {
            "name": "image_name",
            "string": {
              "computed_optional_required": "computed",
              "description": "Docker image name"
            }
          },
          {
            "name": "container_disk_in_gb",
            "int64": {
              "computed_optional_required": "computed",
              "description": "Container disk size in GB"
            }
          },
          {
            "name": "memory_in_gb",
            "float64": {
              "computed_optional_required": "computed",
              "description": "Memory allocated in GB"
            }
          },
          {
            "name": "cost_per_hr",
            "float64": {
              "computed_optional_required": "computed",
              "description": "Cost per hour"
            }
          },
          {
            "name": "created_at",
            "string": {
              "computed_optional_required": "computed",
              "description": "Creation timestamp"
            }
          },
          {
            "name": "desired_status",
            "string": {
              "computed_optional_required": "computed",
              "description": "Desired pod status"
            }
          },
          {
            "name": "docker_args",
            "string": {
              "computed_optional_required": "computed",
              "description": "Docker arguments"
            }
          },
          {
            "name": "env",
            "list": {
              "computed_optional_required": "computed",
              "element_type": {
                "string": {}
              },
              "description": "Environment variables"
            }
          },
          {
            "name": "ports",
            "string": {
              "computed_optional_required": "computed",
              "description": "Port configuration"
            }
          },
          {
            "name": "template_id",
            "string": {
              "computed_optional_required": "computed",
              "description": "Template ID used for this pod"
            }
          },
          {
            "name": "volume_in_gb",
            "float64": {
              "computed_optional_required": "computed",
              "description": "Volume size in GB"
            }
          },
          {
            "name": "volume_mount_path",
            "string": {
              "computed_optional_required": "computed",
              "description": "Volume mount path"
            }
          },
          {
            "name": "machine_type",
            "string": {
              "computed_optional_required": "computed",
              "description": "Machine type"
            }
          }
        ]
      }
    },
    {
      "name": "machine",
