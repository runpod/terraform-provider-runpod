        "attributes": [
          {
            "name": "endpoint_id",
            "string": {
              "computed_optional_required": "required",
              "description": "Endpoint ID"
            }
          },
          {
            "name": "status",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Filter by worker status"
