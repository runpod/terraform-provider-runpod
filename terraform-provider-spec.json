          {
            "name": "container_registry_auth_id",
            "string": {
              "computed_optional_required": "computed",
              "description": "Container registry authentication ID"
            }
          },
          {
            "name": "docker_entrypoint",
            "list": {
              "computed_optional_required": "computed",
              "element_type": {
                "string": {}
              },
              "description": "Docker entrypoint array"
            }
          },
          {
            "name": "docker_start_cmd",
            "list": {
              "computed_optional_required": "computed",
              "element_type": {
                "string": {}
              },
              "description": "Docker start command array"
            }
          },
          {
            "name": "env",
            "map": {
              "computed_optional_required": "computed",
              "element_type": {
                "string": {}
              },
              "description": "Environment variables"
            }
          },
          {
            "name": "is_public",
