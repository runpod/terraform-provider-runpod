  "resources": [
    {
      "name": "pod",
      "description": "Manage RunPod pods - create, update, stop, and terminate pods",
      "schema": {
        "attributes": [
          {
            "name": "id",
            "string": {
              "computed_optional_required": "computed",
              "description": "Pod ID (assigned after creation)"
            }
          },
          {
            "name": "name",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Pod name"
            }
          },
          {
            "name": "machine_id",
            "string": {
              "computed_optional_required": "optional",
              "description": "Machine ID to deploy pod on (optional if gpu_type_id is specified)"
            }
          },
          {
            "name": "cloud_type",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Cloud type: COMMUNITY, SECURE, or ALL"
            }
          },
          {
            "name": "image_name",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Docker image name (required if template_id is not specified)"
            }
          },
          {
            "name": "gpu_count",
            "int64": {
              "computed_optional_required": "computed_optional",
              "default": {
                "static": 1
              },
              "description": "Number of GPUs (default: 1)"
            }
          },
          {
            "name": "gpu_type_id",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Specific GPU type ID (optional, will auto-select if not specified)"
            }
          },
          {
            "name": "docker_args",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Docker arguments"
            }
          },
          {
            "name": "env",
            "list": {
              "computed_optional_required": "computed_optional",
              "element_type": {
                "string": {}
              },
              "description": "Environment variables as ['KEY=VALUE', ...]"
            }
          },
          {
            "name": "port",
            "int64": {
              "computed_optional_required": "computed_optional",
              "description": "Main port for the pod"
            }
          },
          {
            "name": "ports",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Port configuration string"
            }
          },
          {
            "name": "volume_in_gb",
            "float64": {
              "computed_optional_required": "computed_optional",
              "description": "Volume size in GB"
            }
          },
          {
            "name": "volume_key",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Volume encryption key",
              "sensitive": true
            }
          },
          {
            "name": "volume_mount_path",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Volume mount path"
            }
          },
          {
            "name": "container_disk_in_gb",
            "int64": {
              "computed_optional_required": "computed_optional",
              "description": "Container disk size in GB"
            }
          },
          {
            "name": "template_id",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Pod template ID (optional, auto-select if not specified)"
            }
          },
          {
            "name": "stop_after",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Auto-stop timestamp (ISO 8601)"
            }
          },
          {
            "name": "terminate_after",
            "string": {
              "computed_optional_required": "computed_optional",
              "description": "Auto-terminate timestamp (ISO 8601)"
            }
          },
          {
            "name": "start_jupyter",
