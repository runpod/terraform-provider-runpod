            }
          },
          {
            "name": "disk_total",
            "int64": {
              "computed_optional_required": "computed",
              "description": "Total disk in GB"
            }
          },
          {
            "name": "disk_reserved",
            "int64": {
              "computed_optional_required": "computed",
              "description": "Reserved disk in GB"
            }
          },
          {
            "name": "listed",
            "bool": {
              "computed_optional_required": "computed",
              "description": "Whether machine is listed"
            }
          },
          {
            "name": "verified",
            "bool": {
              "computed_optional_required": "computed",
              "description": "Whether machine is verified"
            }
          },
          {
            "name": "secure_cloud",
            "bool": {
              "computed_optional_required": "computed",
              "description": "Whether machine is in secure cloud"
            }
          },
          {
            "name": "host_price_per_gpu",
            "float64": {
              "computed_optional_required": "computed",
              "description": "Host price per GPU"
            }
          },
          {
            "name": "data_center_id",
            "string": {
              "computed_optional_required": "computed",
              "description": "Data center ID"
            }
          },
          {
            "name": "location",
            "string": {
              "computed_optional_required": "computed",
              "description": "Location/country code"
            }
          },
          {
            "name": "maintenance_mode",
            "bool": {
              "computed_optional_required": "computed",
              "description": "Whether machine is in maintenance mode"
            }
          },
          {
            "name": "runpod_ip",
            "string": {
              "computed_optional_required": "computed",
              "description": "RunPod IP address"
            }
          }
